# Large data files (except processed outputs)
!data/outputs/**/*.csv
!data/outputs/*.csv
*.asc
*.lock

# Raw / regenerable data too large for git
data/raw/

# ERA5: ignore raw NetCDF and hourly CSVs, but keep the small monthly
# aggregates (they are model inputs consumed by scripts/forecasting).
data/era5/*
!data/era5/csv_monthly/

# Large archives
*.zip

# Python
__pycache__/
*.py[cod]
*.pyo
.env
.venv/

# Jupyter
.ipynb_checkpoints/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
